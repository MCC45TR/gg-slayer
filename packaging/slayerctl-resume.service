[Unit]
Description=Slayer Control - restore selected settings after resume
Before=sleep.target
StopWhenUnneeded=yes
ConditionPathExists=/etc/slayerctl/slayerctl.conf

[Service]
Type=oneshot
RuntimeDirectory=slayerctl
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/slayerctl /run/lock
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/usr/bin/slayerctl apply-config
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=sleep.target
