From: MCC45TR <mcc45tr@gmail.com>
Subject: [PATCH] Delegate automatic keyboard dimming independently of screens and sleep

Keep manual brightness controls intact. Reuse PolicyAgent lifetime and sender
tracking; policy 8 never implies screen or sleep inhibition.
Based on KDE PowerDevil v6.8.3, GPL-2.0-or-later.

diff --git a/daemon/actions/bundled/dimdisplay.cpp b/daemon/actions/bundled/dimdisplay.cpp
index 0ff7be9..c96528f 100644
--- a/daemon/actions/bundled/dimdisplay.cpp
+++ b/daemon/actions/bundled/dimdisplay.cpp
@@ -34,6 +34,13 @@ DimDisplay::DimDisplay(QObject *parent)
     connect(policyAgent, &PowerDevil::PolicyAgent::unavailablePoliciesChanged, this, &DimDisplay::onUnavailablePoliciesChanged);

     m_inhibitScreen = policyAgent->unavailablePolicies() & PowerDevil::PolicyAgent::ChangeScreenSettings;
+
+    // Keep manual changes (including off) during delegation for a later handoff.
+    connect(core()->keyboardBrightnessController(), &KeyboardBrightnessController::brightnessInfoChanged, this, [this](const auto &info) {
+        if (PolicyAgent::instance()->unavailablePolicies() & PolicyAgent::ChangeKeyboardBacklight) {
+            m_oldKeyboardBrightness = info.value;
+        }
+    });
 }

 void DimDisplay::onWakeupFromIdle()
@@ -75,6 +82,9 @@ void DimDisplay::onIdleTimeout(std::chrono::milliseconds timeout)

 void DimDisplay::setKeyboardBrightnessHelper(int keyboardBrightness)
 {
+    if (PolicyAgent::instance()->unavailablePolicies() & PolicyAgent::ChangeKeyboardBacklight) {
+        return;
+    }
     // don't manipulate keyboard brightness if it's already zero to prevent races with DPMS action
     if (m_oldKeyboardBrightness > 0) {
         core()->keyboardBrightnessController()->setBrightness(keyboardBrightness);
diff --git a/daemon/actions/bundled/dpms.cpp b/daemon/actions/bundled/dpms.cpp
index 2b8ec6e..d7a976e 100644
--- a/daemon/actions/bundled/dpms.cpp
+++ b/daemon/actions/bundled/dpms.cpp
@@ -53,6 +53,13 @@ DPMS::DPMS(QObject *parent)

     m_inhibitScreen = policyAgent->unavailablePolicies() & PowerDevil::PolicyAgent::ChangeScreenSettings;

+    // Keep manual changes (including off) during delegation for a later handoff.
+    connect(core()->keyboardBrightnessController(), &KeyboardBrightnessController::brightnessInfoChanged, this, [this](const auto &info) {
+        if (PolicyAgent::instance()->unavailablePolicies() & PolicyAgent::ChangeKeyboardBacklight) {
+            m_oldKeyboardBrightness = info.value;
+        }
+    });
+
     connect(core()->suspendController(), &SuspendController::aboutToSuspend, this, &DPMS::onAboutToSuspend);
     connect(core()->suspendController(), &SuspendController::resumeFromSuspend, this, &DPMS::onResumeFromSuspend);

@@ -121,6 +128,9 @@ void DPMS::onIdleTimeout(std::chrono::milliseconds /*timeout*/)

 void DPMS::setKeyboardBrightnessHelper(int brightness)
 {
+    if (PolicyAgent::instance()->unavailablePolicies() & PolicyAgent::ChangeKeyboardBacklight) {
+        return;
+    }
     trigger({{u"KeyboardBrightness"_s, QVariant::fromValue(brightness)}});
 }

diff --git a/daemon/dbus/org.kde.Solid.PowerManagement.PolicyAgent.xml b/daemon/dbus/org.kde.Solid.PowerManagement.PolicyAgent.xml
index db71ca8..2412522 100644
--- a/daemon/dbus/org.kde.Solid.PowerManagement.PolicyAgent.xml
+++ b/daemon/dbus/org.kde.Solid.PowerManagement.PolicyAgent.xml
@@ -30,6 +30,9 @@
       </doc:doc>
     </property>

+    <!-- 8 delegates automatic keyboard backlight changes only. -->
+    <property name="SupportedInhibitionTypes" type="u" access="read"/>
+
     <method name="AddInhibition">
       <arg name="types" type="u" direction="in" />
       <arg name="app_name" type="s" direction="in" />
diff --git a/daemon/powerdevilpolicyagent.cpp b/daemon/powerdevilpolicyagent.cpp
index 8ed1edc..ecc2af6 100644
--- a/daemon/powerdevilpolicyagent.cpp
+++ b/daemon/powerdevilpolicyagent.cpp
@@ -444,6 +444,9 @@ QString PolicyAgent::logindWhatForPolicies(PolicyAgent::RequiredPolicies policie
     if (policies & ChangeScreenSettings) {
         what.append(u"idle"_s);
     }
+    if (policies & ChangeKeyboardBacklight) {
+        what.append(u"keyboard-backlight"_s);
+    }
     return what.join(":"_L1);
 }

@@ -538,6 +541,9 @@ PolicyAgent::RequiredPolicies PolicyAgent::unavailablePolicies()
         retpolicies |= InterruptSession;
     }

+    if (!m_typesToCookie[ChangeKeyboardBacklight].isEmpty()) {
+        retpolicies |= ChangeKeyboardBacklight;
+    }
     return retpolicies;
 }

@@ -585,6 +591,9 @@ PolicyAgent::RequiredPolicies PolicyAgent::requirePolicyCheck(PolicyAgent::Requi
         }
     }

+    if ((policies & ChangeKeyboardBacklight) && !m_typesToCookie[ChangeKeyboardBacklight].isEmpty()) {
+        retpolicies |= ChangeKeyboardBacklight;
+    }
     return retpolicies;
 }

@@ -629,7 +638,9 @@ uint PolicyAgent::addInhibitionWithExplicitDBusService(uint types, const QString
     // wait 5s before actually enforcing the inhibition
     // there might be short interruptions (such as receiving a message) where an app might automatically
     // post an inhibition but we don't want the system to constantly wakeup because of this
-    QTimer::singleShot(5000, this, [this, cookie, service, inhibition] {
+    // A keyboard delegate must own dimming before the next screen idle action.
+    // Other policies retain their existing anti-flapping delay.
+    QTimer::singleShot(types == ChangeKeyboardBacklight ? 0 : 5000, this, [this, cookie, service, inhibition] {
         qCDebug(POWERDEVIL) << "Enforcing inhibition from" << service << inhibition.who << "with cookie" << cookie << "and reason" << inhibition.why;

         if (!m_pendingInhibitions.contains(cookie)) {
@@ -724,6 +735,11 @@ void PolicyAgent::addInhibitionTypeHelper(uint cookie, PolicyAgent::RequiredPoli
         m_typesToCookie[InterruptSession].append(cookie);
     }

+    if (types & ChangeKeyboardBacklight) {
+        notify |= m_typesToCookie[ChangeKeyboardBacklight].isEmpty();
+        m_typesToCookie[ChangeKeyboardBacklight].append(cookie);
+    }
+
     if (notify) {
         // emit the signal - inhibition has changed
         Q_EMIT unavailablePoliciesChanged(unavailablePolicies());
@@ -786,6 +802,10 @@ void PolicyAgent::ReleaseInhibition(uint cookie, bool retainCookie)
         }
     }

+    if (m_typesToCookie[ChangeKeyboardBacklight].removeOne(cookie)) {
+        notify |= m_typesToCookie[ChangeKeyboardBacklight].isEmpty();
+    }
+
     if (notify) {
         // Emit the signal - inhibition has changed
         Q_EMIT unavailablePoliciesChanged(unavailablePolicies());
diff --git a/daemon/powerdevilpolicyagent.h b/daemon/powerdevilpolicyagent.h
index 41c8b45..105fd5a 100644
--- a/daemon/powerdevilpolicyagent.h
+++ b/daemon/powerdevilpolicyagent.h
@@ -79,14 +79,19 @@ class POWERDEVILCORE_EXPORT PolicyAgent : public QObject, protected QDBusContext
 public:
     Q_PROPERTY(QList<PolicyAgentInhibition> RequestedInhibitions READ listRequestedInhibitions)
     Q_PROPERTY(QList<PolicyAgentInhibition> ActiveInhibitions READ listActiveInhibitions)
+    Q_PROPERTY(uint SupportedInhibitionTypes READ supportedInhibitionTypes CONSTANT)

     enum RequiredPolicy {
         None = 0,
         InterruptSession = 1,
         ChangeScreenSettings = 4,
+        // Delegate automatic keyboard dimming without inhibiting screens or sleep.
+        ChangeKeyboardBacklight = 8,
     };
     Q_DECLARE_FLAGS(RequiredPolicies, RequiredPolicy)

+    uint supportedInhibitionTypes() const { return InterruptSession | ChangeScreenSettings | ChangeKeyboardBacklight; }
+
     static PolicyAgent *instance();

     ~PolicyAgent() override;
